{
  "name": "meta-analysis-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "start:worker": "LOG_PRETTY=true LOG_AGENT_OUTPUT=true node worker.js",
    "start:worker:json": "node worker.js",
    "dev:worker": "LOG_PRETTY=true LOG_AGENT_OUTPUT=true node --watch worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "localstack:up": "docker compose -f docker-compose.localstack.yml up -d",
    "localstack:down": "docker compose -f docker-compose.localstack.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1106.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "langsmith": "^0.8.10",
    "mysql2": "^3.12.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "vitest": "^3.0.7"
  }
}
