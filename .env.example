PORT=3000
GEMINI_API_KEY=
GEMINI_AGENT_MODEL=gemini-2.5-flash
GEMINI_PHASE_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_MS=240000

AWS_REGION=us-east-1
SQS_QUEUE_URL=
# Leave empty for AWS; set http://localhost:4566 for LocalStack.
SQS_ENDPOINT_URL=
# LocalStack only: use test/test as dummy credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_VISIBILITY_TIMEOUT_SECONDS=300
SQS_HEARTBEAT_SECONDS=120
SQS_LONG_POLL_SECONDS=20
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=meta_analysis
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=meta_analysis_mvp
MYSQL_CONNECTION_LIMIT=5
MAX_STEPS=20
MAX_ATTEMPTS_PER_PHASE=3
RECOVERY_STALE_SECONDS=30
LOG_LEVEL=info
# `npm run start:worker` enables these for local readable diagnostics.
LOG_PRETTY=false
LOG_AGENT_OUTPUT=false
